<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gesture_control</name>
  <version>0.0.0</version>
  <description>Распознавание жестов руки (кулак/открытая ладонь) через камеру и MediaPipe, публикация в /flight_cmd</description>
  <maintainer email="riret@todo.todo">riret</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!--
    cv2 и mediapipe не объявлены как ROS-зависимости: они ставятся через
    pip в venv ai_env (jedi_drone_ws/ai_env), не через rosdep/apt. Нода
    должна запускаться в окружении, где сорснут /opt/ros/jazzy/setup.bash
    (даёт rclpy) и активен ai_env (даёт cv2/mediapipe) — см. README пакета.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
